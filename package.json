{
  "name": "alhram-service",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --experimental-vm-modules --no-warnings --test tests/app.test.mjs tests/account-security.test.mjs && python tests/check_markup.py",
    "test:rules": "firebase emulators:exec --project demo-alhram-rules --only firestore \"node --test tests/firestore.rules.test.mjs\"",
    "deploy:rules": "firebase deploy --only firestore:rules --project alhram-teknik-servies",
    "test:auth": "firebase emulators:exec --project demo-alhram-rules --only auth \"node --test tests/auth.integration.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.4.0",
    "firebase-tools": "15.37.0"
  }
}
